# ====================================================================
# FISHERIES SUPER-AGENT ENVIRONMENT CONFIGURATION
# Fill in your keys below and rename this file to ".env"
# ====================================================================

# Your core brain provider (Get this from openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: direct Anthropic account, used when you switch with `provider anthropic` (agent prompt),
# `python -m utils.llm_provider anthropic`, or `start_batch.bat anthropic`. Only anthropic/... models run on it.
# ANTHROPIC_API_KEY=sk-ant-...
# Default account when nothing has been switched: openrouter or anthropic.
# LLM_PROVIDER=openrouter

# Optional: models. Main model does runs/planning/interpretation; the fast model does simple lookups (use "off" to disable).
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# OPENROUTER_FAST_MODEL=anthropic/claude-haiku-4.5
# PDF ingest: default model, and the model tried once when it runs out of output room ("off" disables).
# OPENROUTER_INGEST_MODEL=anthropic/claude-haiku-5.5
# OPENROUTER_FALLBACK_MODEL=anthropic/claude-sonnet-5.5
# Seconds the PDF watcher waits at "Add them to the brain now?" before assuming yes (0 = always wait).
# INGEST_AUTO_YES_SECONDS=15

# Optional: Path overrides if your data lives outside this workspace
# DATA_DIRECTORY_PATH=/absolute/path/to/your/field/data

# Preferred execution engine for statistical scripts (R or Python)
PRIMARY_STATS_ENGINE=R
