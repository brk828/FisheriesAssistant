---
import { SITE_TITLE } from "../config";
const { title = SITE_TITLE } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style is:global>
      :root { --ink:#1b2a33; --muted:#5b6b75; --line:#d8e0e5; --accent:#0b5d7a; --bg:#f6f9fb; }
      * { box-sizing: border-box; }
      body { margin:0; font:16px/1.55 system-ui, sans-serif; color:var(--ink); background:var(--bg); }
      header.site { background:var(--accent); color:#fff; padding:.9rem 1.2rem; }
      header.site a { color:#fff; text-decoration:none; font-weight:600; font-size:1.15rem; }
      main { max-width:56rem; margin:0 auto; padding:1.4rem 1.2rem 3rem; }
      a { color:var(--accent); }
      footer { text-align:center; color:var(--muted); font-size:.85rem; padding:1.5rem; }
    </style>
  </head>
  <body>
    <header class="site"><a href={base}>{SITE_TITLE}</a></header>
    <main><slot /></main>
    <footer>Summaries are AI-generated and may contain errors; consult the original document.</footer>
  </body>
</html>
